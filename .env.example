# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
PORT=3001
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/back_office
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/back_office_test

# 시드 관리자: 모두 비우면 건너뛰고, 일부만 채우면 API 시작이 중단된다.
# 비밀번호는 8~200자, 표시 이름을 비우면 '관리자'
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=

# 비밀번호 재설정 메일: RESEND_API_KEY가 없으면 메일 대신 재설정 링크를 서버 로그에 남긴다.
# MAIL_FROM을 비우면 onboarding@resend.dev (Resend 가입 계정 주소로만 발송 가능)
RESEND_API_KEY=
MAIL_FROM=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=back_office
